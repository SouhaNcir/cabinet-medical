# Modèle de configuration : copier ce fichier vers .env, puis adapter les valeurs.
# Ne JAMAIS écrire de vrai mot de passe dans ce fichier : il est versionné.

APP_ENV=development

# Laisser vide si l'application est servie à la racine (Docker).
# Mettre /Cabinet/public si elle est servie sous XAMPP.
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cabinet_medical
DB_USER=root
DB_PASS=changer-moi