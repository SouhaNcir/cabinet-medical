# Configuration de l'application
APP_ENV=development

# Laisser vide si l'application est servie à la racine (Docker).
# Mettre /Cabinet/public si elle est servie sous XAMPP.
BASE_URL=

# Configuration MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cabinet_medical
DB_USER=cabinet_user
DB_PASS=change-this-app-password

# Mot de passe administrateur MySQL pour Docker
MYSQL_ROOT_PASSWORD=change-this-root-password
